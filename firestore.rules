rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write on alerts collection
    match /alerts/{alertId} {
      allow read: if true;
      allow write: if true;
    }

    // Allow read/write on user_tokens collection
    match /user_tokens/{tokenId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
