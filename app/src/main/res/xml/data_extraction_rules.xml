<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="user_prefs.xml"/>
        <include domain="sharedpref" path="language_prefs.xml"/>
        <include domain="sharedpref" path="location_prefs.xml"/>
        <exclude domain="sharedpref" path="fcm_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="user_prefs.xml"/>
        <include domain="sharedpref" path="language_prefs.xml"/>
        <include domain="sharedpref" path="location_prefs.xml"/>
        <exclude domain="sharedpref" path="fcm_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>